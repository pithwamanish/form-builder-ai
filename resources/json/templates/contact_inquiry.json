{
  "title": "Contact Us",
  "description": "Get in touch with our team. We reply within 24 hours.",
  "settings": {
    "display_mode": "single_page",
    "layout_mode": "freeform"
  },
  "sections": [
    {
      "id": "sec_contact",
      "title": "Your Message",
      "fields": [
        {
          "id": "fld_c_name",
          "key": "contact_name",
          "type": "text",
          "label": "Your Name",
          "required": true,
          "col_span": 6,
          "row_span": 1,
          "valign": "center"
        },
        {
          "id": "fld_c_email",
          "key": "contact_email",
          "type": "email",
          "label": "Email Address",
          "required": true,
          "col_span": 6,
          "row_span": 1,
          "valign": "center"
        },
        {
          "id": "fld_c_subject",
          "key": "inquiry_subject",
          "type": "dropdown",
          "label": "Subject / Category",
          "options": ["General Support", "Sales & Pricing", "Partnership", "Media Inquiry"],
          "required": true,
          "col_span": 12,
          "row_span": 1,
          "valign": "center"
        },
        {
          "id": "fld_c_message",
          "key": "message_body",
          "type": "textarea",
          "label": "Message",
          "placeholder": "How can we help you?",
          "required": true,
          "col_span": 12,
          "row_span": 2,
          "valign": "top"
        }
      ]
    }
  ]
}
